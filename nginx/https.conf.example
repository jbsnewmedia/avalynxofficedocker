# TLS termination in the nginx edge (HTTPS mode 2) - HTTPS server only.
#
# Enable via compose (see the commented blocks in compose.yaml):
#   - mount this file to /etc/nginx/conf.d/https/https.conf
#   - mount your certificates to /etc/nginx/certs (fullchain.pem + privkey.pem)
#   - publish ${HTTPS_BIND:-0.0.0.0}:${HTTPS_PORT:-443}:443
#   - mount nginx/http-redirect.conf (copy of http-redirect.conf.example)
#     to /etc/nginx/conf.d/default.conf INSTEAD of nginx.conf
#
# This file deliberately contains no port-80 server: the port-80 server comes
# from the file mounted as default.conf. With TLS enabled that must be
# http-redirect.conf, which redirects everything (not only ActiveSync) with
# `return 308 https://$host$request_uri` and defines the shared limit zones.
# Mounting nginx.conf AND this file at the same time is a misconfiguration:
# plain HTTP would still proxy the web client without TLS.
#
# The web client then generates https:// URLs as soon as TRUSTED_PROXIES is
# set for the office container (see .env.example / README).
#
# Security headers are set on server level only (add_header in a location
# would replace all server-level headers for that location).
# Mozilla "intermediate" TLS profile (https://ssl-config.mozilla.org/).

server {
    listen 443 ssl;
    http2 on;
    # Recommended: set your real host name here (and in http-redirect.conf)
    # instead of the catch-all; see N6 in the README.
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling (needs the issuer chain in fullchain.pem; nginx only warns
    # when it is missing, e.g. with self-signed certificates). The resolver is
    # the embedded Docker DNS.
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=300s;
    resolver_timeout 5s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    client_max_body_size 64m;

    # ActiveSync endpoint -> eas plugin container (separate AGPL project).
    # Zone eas_conn is defined in http-redirect.conf (max. 20 connections per IP).
    location /Microsoft-Server-ActiveSync {
        limit_conn eas_conn 20;
        proxy_pass http://eas:80;
        proxy_http_version 1.1;
        # ActiveSync Ping requests are long polls - do not cut them off.
        proxy_read_timeout 370s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Web login with rate limit (zone office_login from http-redirect.conf).
    location = /login {
        limit_req zone=office_login burst=10 nodelay;
        proxy_pass http://office:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else -> AvalynxOffice web client.
    location / {
        proxy_pass http://office:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
