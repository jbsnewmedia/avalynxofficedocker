# TLS termination in the nginx edge.
#
# Enable via compose (see the commented blocks in compose.yaml):
#   - mount this file to /etc/nginx/conf.d/https/https.conf
#   - mount your certificates to /etc/nginx/certs (fullchain.pem + privkey.pem)
#   - publish ${HTTPS_PORT:-443}:443
#
# The web client then generates https:// URLs as soon as TRUSTED_PROXIES is
# set for the office container (see .env.example / README).

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 200m;

    # ActiveSync endpoint -> eas plugin container (separate AGPL project).
    location /Microsoft-Server-ActiveSync {
        proxy_pass http://eas:80;
        proxy_http_version 1.1;
        # ActiveSync Ping requests are long polls - do not cut them off.
        proxy_read_timeout 370s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else -> AvalynxOffice web client.
    location / {
        proxy_pass http://office:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
