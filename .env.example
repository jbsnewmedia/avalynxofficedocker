# Host port for the nginx edge (web client + ActiveSync endpoint).
HTTP_PORT=80
# Only needed when TLS termination in the edge is enabled (see README).
HTTPS_PORT=443

# Only trust the fixed Compose nginx edge. Do not trust entire private ranges;
# clients or unrelated containers could forge forwarded headers.
TRUSTED_PROXIES=172.30.0.2

# PostgreSQL (the all-in-one database for AvalynxOffice and the EAS plugin).
# POSTGRES_USER is the owner role used by the office container (migrations).
POSTGRES_DB=avalynxoffice
POSTGRES_USER=avalynxoffice
POSTGRES_PASSWORD=change-me

# Least-privilege database role for the ActiveSync (EAS) container. The role
# is created by postgres/init/01-eas-role.sh on the first start (fresh volume)
# and receives read access to all tables plus write access to the mail,
# contact and calendar tables from the office entrypoint after every
# migration run. Generate the password with: openssl rand -hex 16
EAS_DB_USER=eas_user
EAS_DB_PASSWORD=

# Symfony app secret of the web client. Generate with: openssl rand -hex 16
APP_SECRET=

# Key for encrypting stored mail account credentials (base64 of 32 random
# bytes). Generate with: openssl rand -base64 32
# Keep it together with the database backup: without this key the stored
# mail passwords cannot be decrypted and must be re-entered by every user.
AVALYNXOFFICE_ENCRYPTION_KEY=

# Administrator created on first start-up of the office container
# (idempotent: an existing user is never overwritten). Remove the password
# from this file after the first successful start - it is only needed once.
OFFICE_ADMIN_EMAIL=admin@example.com
OFFICE_ADMIN_PASSWORD=

# Infrastructure images
NGINX_IMAGE=nginx:1.30-alpine
POSTGRES_IMAGE=postgres:18-alpine

# Image tags
OFFICE_TAG=latest
EAS_TAG=latest
