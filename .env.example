# Host port for the nginx edge (web client + ActiveSync endpoint).
HTTP_PORT=80
# Bind address of the published port(s). Default 0.0.0.0 (all interfaces).
# HTTPS mode 1 - external reverse proxy on the same host terminates TLS: bind to
# the loopback interface so the plain-HTTP stack is not reachable from the
# network, and let the proxy set X-Forwarded-For/-Proto (see README).
# HTTP_BIND=127.0.0.1
# Only needed when TLS termination in the edge is enabled (HTTPS mode 2, see README).
HTTPS_PORT=443
# HTTPS_BIND=0.0.0.0

# Only trust the fixed Compose nginx edge. Do not trust entire private ranges
# (/8, /12, /16); clients or unrelated containers could forge forwarded
# headers. `core.sh up` warns about any other value. In HTTPS mode 1 add the single
# address of the external proxy (comma separated) only if it talks to the
# office container directly.
TRUSTED_PROXIES=172.30.0.2

# PostgreSQL (the all-in-one database for AvalynxOffice and the EAS plugin).
# POSTGRES_USER is the owner role used by the office container (migrations).
POSTGRES_DB=avalynxoffice
POSTGRES_USER=avalynxoffice
# Generate with: openssl rand -hex 16 (`core.sh init-env` does this;
# `core.sh up` rejects placeholders and values shorter than 16 characters).
POSTGRES_PASSWORD=

# Least-privilege database role for the ActiveSync (EAS) container. The role
# is created by postgres/init/01-eas-role.sh on the first start (fresh volume)
# and receives explicit grants (read access to the account/user/license
# tables, write access to the mail, contact and calendar tables; see
# eas-grants.sql in the office image) from the office entrypoint after every
# migration run. Generate the password with: openssl rand -hex 16
EAS_DB_USER=eas_user
EAS_DB_PASSWORD=
# Only requests from these addresses (the stack's fixed nginx IP) may carry
# a trusted X-Real-IP header for the EAS auth throttle / auth-failure log.
EAS_TRUSTED_PROXIES=172.30.0.2

# Symfony app secret of the web client. Generate with: openssl rand -hex 16
APP_SECRET=

# Key for encrypting stored mail account credentials (base64 of 32 random
# bytes). Generate with: openssl rand -base64 32
# Keep it together with the database backup: without this key the stored
# mail passwords cannot be decrypted and must be re-entered by every user.
AVALYNXOFFICE_ENCRYPTION_KEY=

# Administrator created on first start-up of the office container
# (idempotent: an existing user is never overwritten). Remove the password
# from this file after the first successful start - it is only needed once
# (the entrypoint logs a warning while it is still set). Alternative: a
# Compose secret via OFFICE_ADMIN_PASSWORD_FILE (see compose.yaml / README).
OFFICE_ADMIN_EMAIL=admin@example.com
OFFICE_ADMIN_PASSWORD=

# Infrastructure images
NGINX_IMAGE=nginx:1.30-alpine
POSTGRES_IMAGE=postgres:18-alpine

# Image tags. In production pin both to a released version (e.g. 1.0.2)
# instead of the floating "latest" so an update is a deliberate step.
OFFICE_TAG=latest
EAS_TAG=latest

# Resource limits per container (Docker memory / pids cgroup limits). Raise
# them for large installations; a container that exceeds its memory limit
# is OOM-killed and restarted.
# NGINX_MEM_LIMIT=128m
# NGINX_PIDS_LIMIT=256
# OFFICE_MEM_LIMIT=1g
# OFFICE_PIDS_LIMIT=256
# EAS_MEM_LIMIT=512m
# EAS_PIDS_LIMIT=256
# DB_MEM_LIMIT=1g
# DB_PIDS_LIMIT=512
