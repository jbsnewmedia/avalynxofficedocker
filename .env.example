# Host port for the nginx edge (web client + ActiveSync endpoint).
HTTP_PORT=80
# Only needed when TLS termination in the edge is enabled (see README).
HTTPS_PORT=443

# Only trust the fixed Compose nginx edge. Do not trust entire private ranges;
# clients or unrelated containers could forge forwarded headers.
TRUSTED_PROXIES=172.30.0.2

# PostgreSQL (the all-in-one database for AvalynxOffice and the EAS plugin).
POSTGRES_DB=avalynxoffice
POSTGRES_USER=avalynxoffice
POSTGRES_PASSWORD=change-me

# Symfony app secret of the web client. Generate with: openssl rand -hex 16
APP_SECRET=

# Administrator created on first start-up of the office container
# (idempotent: an existing user is never overwritten).
OFFICE_ADMIN_EMAIL=admin@example.com
OFFICE_ADMIN_PASSWORD=

# Infrastructure images
NGINX_IMAGE=nginx:1.30-alpine
POSTGRES_IMAGE=postgres:18-alpine

# Image tags
OFFICE_TAG=latest
EAS_TAG=latest
